{
  "name": "flyeye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check:code": "node scripts/check-code-maintainability.mjs",
    "check:docs": "node scripts/check-documentation.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:sql": "supabase test db",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:edge-runtime": "node scripts/test-edge-runtime.mjs",
    "test:recovery-runtime": "node scripts/test-recovery-runtime.mjs",
    "test:runtime": "node scripts/run-runtime-matrix.mjs",
    "validate:feat003-staging": "node scripts/validate-feat-003-staging-manifest.mjs",
    "check:browser-secrets": "node scripts/check-browser-secrets.mjs --require-dist",
    "verify:app": "pnpm format:check && pnpm check:docs && pnpm check:code && pnpm lint && pnpm typecheck && pnpm validate:feat003-staging && pnpm test:coverage && pnpm build && pnpm check:browser-secrets && pnpm test:e2e && pnpm audit --audit-level high",
    "verify:database:running": "pnpm db:reset && pnpm test:sql && pnpm test:runtime && pnpm exec supabase db lint --local --level warning --fail-on warning && pnpm db:types:check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
